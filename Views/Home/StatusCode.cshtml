@{
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
    var message = statusCode == 404
        ? "The page or item you requested could not be found."
        : "We couldn't complete your request.";
}
<h1>Request could not be completed</h1>
<p class="text-danger">@message</p>
<a asp-controller="Products" asp-action="Index" class="btn btn-primary">Return to products</a>