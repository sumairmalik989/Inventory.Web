@using Inventory.Application.Contracts
@model ProductStock
<h1>Delete product</h1>
<div class="alert alert-warning">
    This will remove the product from the active inventory. Its stock movement history will be retained.
</div>
<dl class="row">
    <dt class="col-sm-2">SKU</dt>
    <dd class="col-sm-10">@Model.Product.Sku</dd>
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Product.Name</dd>
    <dt class="col-sm-2">Current stock</dt>
    <dd class="col-sm-10">@Model.CurrentStock</dd>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Product.Id" method="post">
    <button type="submit" class="btn btn-danger">Delete product</button>
    <a asp-action="Details" asp-route-id="@Model.Product.Id" class="btn btn-secondary">Cancel</a>
</form>