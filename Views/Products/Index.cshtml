@using Inventory.Application.Contracts
@model List<ProductStock>
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Products</h1><a class="btn btn-primary" asp-action="Create">Add product</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-auto"><input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search SKU or name" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form>
<table class="table table-striped align-middle">
    <thead><tr><th>SKU</th><th>Name</th><th>Current stock</th><th>Reorder level</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product.Sku</td>
                <td>@item.Product.Name</td>
                <td>@item.CurrentStock</td>
                <td>@item.Product.ReorderLevel</td>
                <td>@if (item.CurrentStock <= item.Product.ReorderLevel) {
                    <span class="badge bg-warning text-dark">Low stock</span>
                } else
                {

                    <span class="badge bg-success">In stock</span>
                }
            </td>
                <td><a asp-action="Details" asp-route-id="@item.Product.Id">Details</a> · <a asp-action="Edit" asp-route-id="@item.Product.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Product.Id">Delete</a></td>
        </tr>
    }
</tbody>
</table>
