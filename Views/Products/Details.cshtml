@using Inventory.Application.Contracts
@using Inventory.Domain.Entities
@model ProductStock
<div class="d-flex justify-content-between"><h1>@Model.Product.Name</h1><div><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Product.Id">Edit</a> <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Product.Id">Delete</a> <a asp-action="Index">Back</a></div></div>
<dl class="row"><dt class="col-sm-2">SKU</dt><dd class="col-sm-10">@Model.Product.Sku</dd><dt class="col-sm-2">Description</dt><dd class="col-sm-10">@Model.Product.Description</dd><dt class="col-sm-2">Current stock</dt><dd class="col-sm-10">@Model.CurrentStock</dd><dt class="col-sm-2">Reorder level</dt><dd class="col-sm-10">@Model.Product.ReorderLevel</dd></dl>
<div class="card mb-4">
    <div class="card-header">Record stock movement</div><div class="card-body">
    <form asp-action="Move" asp-route-id="@Model.Product.Id" method="post">
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">Type</label><select name="Type" class="form-select" required><option value="">Select</option><option value="In">In</option><option value="Out">Out</option></select></div>
            <div class="col-md-3"><label class="form-label">Quantity</label><input name="Quantity" type="number" min="1" step="1" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label">Note</label><input name="Note" maxlength="500" class="form-control" /></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Save movement</button></div>
        </div>
        @Html.AntiForgeryToken()
    </form>
</div>
</div>
<h2>Movement history</h2>
<table class="table table-sm">
    <thead><tr><th>When (UTC)</th><th>Type</th><th>Quantity</th><th>Note</th></tr></thead>
    <tbody>
        @foreach (StockMovement movement in (List<StockMovement>)ViewBag.Movements)
        {
            <tr><td>@movement.CreatedUtc.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@movement.Type</td><td>@movement.Quantity</td><td>@movement.Note</td></tr>
        }
    </tbody>
</table>
